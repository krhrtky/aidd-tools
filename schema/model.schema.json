{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidd.dev/schema/model/v1",
  "title": "AIDD Canonical Semantic Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "schemaVersion", "specId", "@graph"],
  "properties": {
    "@context": { "const": "https://aidd.dev/context/v1" },
    "schemaVersion": { "enum": ["1.0", "1.1"] },
    "specId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "@graph": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["@id", "@type", "status", "basis"],
      "additionalProperties": false,
      "properties": {
        "@id": { "type": "string", "pattern": "^urn:aidd:" },
        "@type": {
          "enum": [
            "Requirement", "Term", "Entity", "Type", "State", "Transition",
            "Operation", "Constraint", "Invariant", "Precondition",
            "Postcondition", "Error", "Assumption", "Example",
            "Counterexample", "CodeSymbol", "TestCase", "Contract",
            "Evidence", "HumanDecision", "Parameter", "Result"
          ]
        },
        "label": { "type": "string" },
        "status": { "enum": ["candidate", "accepted", "rejected"] },
        "basis": { "enum": ["stated", "observed", "derived", "assumed"] },
        "generatedBy": { "enum": ["llm", "human", "harness", "extractor"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "expression": { "$ref": "#/$defs/expression" },
        "valueType": { "$ref": "#/$defs/valueType" },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "total": { "type": "boolean" },
        "approvedClaimHashes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^urn:aidd:" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "sourceModelSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "defines": { "$ref": "#/$defs/references" },
        "constrains": { "$ref": "#/$defs/references" },
        "derivesFrom": { "$ref": "#/$defs/references" },
        "dependsOn": { "$ref": "#/$defs/references" },
        "transitionsFrom": { "$ref": "#/$defs/references" },
        "transitionsTo": { "$ref": "#/$defs/references" },
        "implementedBy": { "$ref": "#/$defs/references" },
        "testedBy": { "$ref": "#/$defs/references" },
        "evidencedBy": { "$ref": "#/$defs/references" },
        "contradicts": { "$ref": "#/$defs/references" },
        "supersedes": { "$ref": "#/$defs/references" },
        "accepts": { "$ref": "#/$defs/references" },
        "returns": { "$ref": "#/$defs/references" },
        "mayFailWith": { "$ref": "#/$defs/references" }
      }
    },
    "valueType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["int", "bool", "string"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "typeId"],
          "properties": {
            "kind": { "const": "enum" },
            "typeId": { "type": "string", "pattern": "^urn:aidd:" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "elementType"],
          "properties": {
            "kind": { "enum": ["set", "list"] },
            "elementType": { "$ref": "#/$defs/scalarValueType" }
          }
        }
      ]
    },
    "scalarValueType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["int", "bool", "string"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "typeId"],
          "properties": {
            "kind": { "const": "enum" },
            "typeId": { "type": "string", "pattern": "^urn:aidd:" }
          }
        }
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["@id"],
            "properties": { "@id": { "type": "string" } },
            "additionalProperties": false
          }
        ]
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "startLine", "startColumn", "endLine", "endColumn", "sha256"
      ],
      "properties": {
        "path": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "expression": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "literal", "ref", "variable", "current", "not", "and", "or", "implies", "eq", "neq",
            "lt", "lte", "gt", "gte", "in", "all", "some", "no", "one",
            "always", "eventually", "next", "until",
            "valueRef", "enumLiteral", "setLiteral", "listLiteral",
            "add", "sub", "mul", "size", "contains", "index",
            "union", "intersect", "difference", "append", "concat", "slice"
          ]
        },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "value": {},
        "typeId": { "type": "string" },
        "member": { "type": "string" },
        "valueType": { "$ref": "#/$defs/scalarValueType" },
        "variable": { "type": "string" },
        "domain": { "$ref": "#/$defs/expression" },
        "body": { "$ref": "#/$defs/expression" },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/expression" }
        }
      }
    }
  }
}
