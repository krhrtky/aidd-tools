#!/usr/bin/env sh
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  link_target=$(readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path=$(dirname -- "$script_path")/$link_target ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
tools_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
launcher="$tools_root/build/install/aidd-tools/bin/aidd-tools"

if [ ! -x "$launcher" ]; then
  echo "aidd-tools distribution is not built. Run: $tools_root/gradlew installDist" >&2
  exit 4
fi

export AIDD_TOOLS_HOME="${AIDD_TOOLS_HOME:-$tools_root}"
exec "$launcher" backport "$@"
